{
  "name": "cloak",
  "version": "0.0.0",
  "private": true,
  "description": "Zero-knowledge, developer-centric secrets manager and password vault (desktop).",
  "author": "M. Yousuf <yousuf.work09@gmail.com> (https://github.com/yousuf-git)",
  "homepage": "https://yousuf-dev.com",
  "_developer": {
    "name": "M. Yousuf",
    "github": "https://github.com/yousuf-git",
    "portfolio": "https://yousuf-dev.com"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @cloak/api dev",
    "dev:desktop": "pnpm --filter @cloak/desktop tauri:dev",
    "dev:desktop:ui": "pnpm --filter @cloak/desktop dev",
    "dev:web": "pnpm --filter @cloak/web dev",
    "build:api": "pnpm --filter @cloak/api build",
    "build:desktop": "pnpm --filter @cloak/desktop build",
    "build:web": "pnpm --filter @cloak/web build",
    "ship": "bash scripts/ship.sh",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "brace-expansion@<1.1.18": ">=1.1.18 <2",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9 <6",
      "browserslist@<=4.28.6": ">=4.28.7 <5",
      "ip-address@<=10.3.0": ">=10.3.1 <11",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1 <5",
      "nanoid@<3.3.18": ">=3.3.18 <4",
      "next@>=16.0.0 <16.2.11": ">=16.2.11 <17",
      "postcss@<=8.5.22": ">=8.5.23 <9",
      "qs@>=2.2.5 <6.16.0": ">=6.16.0 <7",
      "react-router@>=7.12.0 <7.18.2": ">=7.18.2 <8",
      "sharp@<0.35.0": ">=0.35.0 <0.36",
      "undici@>=7.0.0 <7.29.0": ">=7.29.0 <8"
    }
  }
}
