# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Rust / Tauri
desktop/src-tauri/target/
target/

# Environment / secrets
.env
.env.*
!.env.example
# Secret-free build config: the sidecar's localhost URL, needed for a clean build.
!desktop/.env.production
*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Agent / editor tooling — never belongs in the repository, at any depth.
# Reticle session journals in particular hold request/response bodies and page
# text captured from the app under test.
.claude
.cursor
.reticle

# Test / coverage
coverage/
.nyc_output/

# Local files
local
config.bat
