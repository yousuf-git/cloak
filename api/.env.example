#
# Cloak server configuration.
#
# Run ./setup.sh to generate this file with fresh secrets already filled in.
# Everything marked REQUIRED must be set before the server will start.
#

# ─── Required ────────────────────────────────────────────────────────────────

# REQUIRED. MongoDB connection string. Atlas, a managed provider, or the
# `mongo` service from docker-compose.yml (mongodb://mongo:27017/cloak).
MONGODB_URI=

# REQUIRED. Generated by setup.sh. Signs access tokens.
# Rotating this logs every user out. Never share it.
JWT_SECRET=

# REQUIRED. Generated by setup.sh. Signs refresh tokens.
REFRESH_SECRET=

# REQUIRED for a fresh deployment. Generated by setup.sh.
# Whoever holds this key becomes the first owner. Hand it to nobody else.
# It stops working the moment the owner account is created — remove it then.
OWNERSHIP_KEY=

# REQUIRED. The address teammates reach this server on, exactly as they would
# type it. Baked into invitation join keys, so a wrong value here hands new
# members an address that cannot connect.
#   https://vault.your-company.com     public, behind TLS
#   http://100.84.12.9:4000            Tailscale
#   http://192.168.1.50:4000           office LAN
PUBLIC_URL=

# ─── Email (strongly recommended) ────────────────────────────────────────────

# Without these the server still runs, but verification codes and invitation
# join keys are written to the server log instead of being delivered. You would
# have to read them out of the log and pass them on by hand.
# Get a key at https://resend.com — the free tier covers a small team.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─── Optional ────────────────────────────────────────────────────────────────

# Unlocks the detailed half of the status page for a browser with no session:
#   https://your-server/?key=<this value>
# Leave empty to keep that detail available only to a signed-in owner.
HEALTH_TOKEN=

# Shown on the status page and in the desktop app's connect screen.
SERVER_NAME=Cloak Server

PORT=4000
NODE_ENV=production
LOG_LEVEL=info

# Browser origins allowed to call the API. The desktop app is not a browser and
# is unaffected. Leave as * unless you are also serving a web client.
CORS_ORIGIN=*

# Token and code lifetimes.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
OTP_TTL_SECONDS=600
INVITATION_TTL_DAYS=7

# How long audit entries are kept. Changing this rebuilds the TTL index.
AUDIT_RETENTION_DAYS=365

# Rate limiting. AUTH_MAX counts only failed sign-in and code attempts.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_MAX=100
RATE_LIMIT_UPLOAD_MAX=20
